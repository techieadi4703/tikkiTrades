# Database Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database_name

# Next.js Server / General URL Configurations
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_HOST_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better-Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Gemini & Groq AI Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CHATTINGKEY=your_gemini_chat_key_here

# Nodemailer Email Configuration
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PASSWORD=your_email_app_password_here

# Market Data API Keys (Finnhub)
FINNHUB_API_KEY=your_finnhub_secret_key_here
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_public_key_here

# Redis Cache configuration
REDIS_URL=redis://localhost:6379

# Express Server Configuration
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Sentry Monitoring Configuration
SENTRY_ORG=your_sentry_org_here
SENTRY_PROJECT=your_sentry_project_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
